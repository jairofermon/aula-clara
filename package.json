{
  "name": "aula-clara",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @aula-clara/web dev",
    "configure:web": "node scripts/sync-web-env.mjs",
    "build": "pnpm --filter @aula-clara/shared build && pnpm --filter @aula-clara/prompts build && pnpm --filter @aula-clara/web build",
    "lint": "pnpm -r lint && pnpm format:check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:python",
    "test:unit": "pnpm --filter @aula-clara/shared test && pnpm --filter @aula-clara/web test",
    "test:python": "python -m pytest services/worker/tests",
    "test:e2e": "playwright test",
    "example:audio": "node scripts/generate-sample-audio.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,mjs}\" \"packages/**/*.{ts,json}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"*.{md,json,yaml,yml,mjs,ts}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,mjs}\" \"packages/**/*.{ts,json}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"*.{md,json,yaml,yml,mjs,ts}\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "supabase": "2.111.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
