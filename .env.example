# URL pública da aplicação web.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# API do Supabase local ou hospedado.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# URL usada pelo consumidor Cloudflare; em produção é igual à URL pública.
SUPABASE_URL=
# URL usada dentro dos containers; deixe vazia na execução sem Docker.
SUPABASE_INTERNAL_URL=
# Chave anon/publishable; pode estar no navegador e continua limitada por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Segredo exclusivo do worker. Nunca use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL direto usado somente pelo worker.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Credencial exclusiva do worker. Deixe vazia com PROVIDER_MODE=fake.
OPENAI_API_KEY=
# Modelos centralizados do provider OpenAI.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_REVIEW_MODEL=gpt-5.6
OPENAI_GENERATION_MODEL=gpt-5.6
# fake evita chamadas pagas e habilita a demonstração local.
PROVIDER_MODE=fake
# Entrega: postgres no worker local; cloudflare na implantação gratuita.
PROCESSING_DISPATCH_MODE=postgres
# Modelos centralizados do Workers AI gratuito.
CLOUDFLARE_TRANSCRIPTION_MODEL=@cf/openai/whisper-large-v3-turbo
CLOUDFLARE_REVIEW_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
CLOUDFLARE_GENERATION_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# Primeira opção gratuita para revisão e materiais, mantida somente no Worker.
CEREBRAS_API_KEY=
CEREBRAS_GENERATION_MODEL=gpt-oss-120b
# Provedor gratuito principal em nuvem. A chave é segredo exclusivo do Worker.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_SEGMENT_REVIEW_MODEL=llama-3.1-8b-instant
GROQ_REVIEW_MODEL=openai/gpt-oss-20b
GROQ_GENERATION_MODEL=groq/compound
# Reserva assíncrona de alta precisão para áudio. Nunca exponha ao navegador.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_TRANSCRIPTION_MODEL=universal-3-pro
DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIPTION_MODEL=nova-3
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-2.5-flash
# Use accepted somente após aceitar que o nível gratuito pode usar conteúdo para melhorar produtos.
GEMINI_DATA_PROCESSING_CONSENT=disabled
OPENROUTER_API_KEY=
OPENROUTER_GENERATION_MODEL=openrouter/free
# O roteador pode encaminhar texto a diferentes operadores; habilite conscientemente.
OPENROUTER_DATA_PROCESSING_CONSENT=disabled
# Tamanho-alvo e sobreposição dos chunks.
AUDIO_CHUNK_TARGET_SECONDS=600
AUDIO_CHUNK_OVERLAP_SECONDS=5
# Limites por arquivo. Materiais usam o teto de 50 MB do Supabase Free.
MAX_AUDIO_UPLOAD_SIZE_MB=50
MAX_MATERIAL_UPLOAD_SIZE_MB=50
MAX_TRANSCRIPTION_CHUNK_MB=15
# Validade de URLs assinadas privadas.
SIGNED_URL_TTL_SECONDS=300
# Identidade/lease/poll do worker.
WORKER_ID=aula-clara-local-1
WORKER_POLL_SECONDS=2
WORKER_LOCK_TTL_SECONDS=300
LOG_LEVEL=INFO
# Custos opcionais por unidade para estimativa; zero desabilita estimativa.
OPENAI_AUDIO_COST_PER_MINUTE=0
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
# Testes E2E/integrados são opt-in.
RUN_E2E=0
RUN_OPENAI_INTEGRATION=0
