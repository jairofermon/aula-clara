# URL pública da aplicação web.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# API do Supabase local ou hospedado.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# URL usada dentro dos containers; deixe vazia na execução sem Docker.
SUPABASE_INTERNAL_URL=
# Chave anon/publishable; pode estar no navegador e continua limitada por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Segredo exclusivo do worker. Nunca use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL direto usado somente pelo worker.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Credencial exclusiva do worker. Deixe vazia com PROVIDER_MODE=fake.
OPENAI_API_KEY=
# Modelos centralizados do provider OpenAI.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_REVIEW_MODEL=gpt-5.6
OPENAI_GENERATION_MODEL=gpt-5.6
# fake evita chamadas pagas e habilita a demonstração local.
PROVIDER_MODE=fake
# Tamanho-alvo e sobreposição dos chunks.
AUDIO_CHUNK_TARGET_SECONDS=600
AUDIO_CHUNK_OVERLAP_SECONDS=5
# Limites de arquivo e de chunk antes do fornecedor.
MAX_UPLOAD_SIZE_MB=500
MAX_TRANSCRIPTION_CHUNK_MB=24
# Validade de URLs assinadas privadas.
SIGNED_URL_TTL_SECONDS=300
# Identidade/lease/poll do worker.
WORKER_ID=aula-clara-local-1
WORKER_POLL_SECONDS=2
WORKER_LOCK_TTL_SECONDS=300
LOG_LEVEL=INFO
# Custos opcionais por unidade para estimativa; zero desabilita estimativa.
OPENAI_AUDIO_COST_PER_MINUTE=0
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
# Testes E2E/integrados são opt-in.
RUN_E2E=0
RUN_OPENAI_INTEGRATION=0
