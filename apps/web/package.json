{
  "name": "@aula-clara/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --secrets-file .secrets.production",
    "cf:types": "wrangler types --env-interface CloudflareEnv",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aula-clara/prompts": "workspace:*",
    "@aula-clara/shared": "workspace:*",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "dompurify": "3.3.1",
    "hash-wasm": "4.12.0",
    "lucide-react": "1.28.0",
    "mermaid": "11.12.2",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/dompurify": "3.0.5",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "^4.118.0"
  }
}
